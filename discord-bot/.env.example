# Discord Bot Token (создайте приложение на https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# ID приложения Discord (Application ID в настройках бота)
DISCORD_CLIENT_ID=your_application_id_here

# Подключение к PostgreSQL (та же БД, что и сайт — Yandex Cloud VM)
DATABASE_URL=postgresql://user:password@host:5432/dbname

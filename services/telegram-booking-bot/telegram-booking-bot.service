[Unit]
Description=Telegram booking notifications (adventurespool)
After=network.target postgresql.service warp-svc.service
Wants=warp-svc.service

[Service]
Type=simple
User=gatricus
WorkingDirectory=/opt/my-rpg-club/services/telegram-booking-bot
EnvironmentFile=/opt/my-rpg-club/services/telegram-booking-bot/.env
ExecStart=/usr/bin/node index.mjs
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

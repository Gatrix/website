# Next.js app
NODE_ENV=development
DATABASE_URL=postgresql://appuser:change-me@localhost:5432/adventurespool
PG_ADVENTURES_SCHEMA=adventurespool
PG_POOL_MAX=5
AUTH_SECRET=change-me-min-32-chars

# Booking API guardrails
BOOKING_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_WINDOW_MS=900000
BOOKING_IDEMPOTENCY_TTL_MS=7200000

# Yandex Metrika
NEXT_PUBLIC_YANDEX_METRIKA_ID=109390759

# Yandex Object Storage
YC_STORAGE_BUCKET=polygon-ttrpg
YC_STORAGE_ACCESS_KEY=
YC_STORAGE_SECRET_KEY=
YC_STORAGE_PREFIX=data/
YC_STORAGE_IMAGES_PREFIX=
YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YC_STORAGE_REGION=ru-central1
YC_STORAGE_IMAGES_BASE=
NEXT_PUBLIC_YC_STORAGE_IMAGES_BASE=
NEXT_PUBLIC_YC_STORAGE_IMAGES_PREFIX=
# PostgreSQL (каталог приключений — БД adventurespool)
# DATABASE_URL=postgresql://appuser:PASSWORD@HOST:5432/adventurespool
# 
# По умолчанию используется новая схема `adventurespool`.
# Старую плоскую схему можно включить: `PG_ADVENTURES_SCHEMA=legacy` (раскомментируйте).

# Яндекс.Метрика (номер счётчика). По умолчанию в коде: 109390759
NEXT_PUBLIC_YANDEX_METRIKA_ID=109390759
